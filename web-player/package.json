{
  "name": "@tapscene/web-player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && node --import tsx --test test/*.test.ts",
    "test:browser": "node --import tsx test/browser-smoke.ts"
  },
  "dependencies": {
    "@tapscene/runtime-ts": "0.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "playwright": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
